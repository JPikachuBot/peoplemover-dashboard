# ── Transit ──────────────────────────────────────────────────────────
# WMATA (Washington DC Metro) — get a free key at developer.wmata.com
WMATA_API_KEY=your_wmata_api_key_here

# MTA (NYC Subway) — get a free key at api.mta.info
MTA_API_KEY=your_mta_api_key_here

# ── Traffic ──────────────────────────────────────────────────────────
# Set whichever matches traffic.provider in config.yaml
# Google Maps: console.cloud.google.com → Directions API
TRAFFIC_API_KEY=your_traffic_api_key_here

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
